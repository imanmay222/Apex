# Copy to .env and fill in. Every value here is required unless marked optional.

# --- MongoDB ---
MONGO_ROOT_USER=apex_root
MONGO_ROOT_PASSWORD=change-me
MONGO_APP_DB=apex
MONGO_APP_USER=apex_app
MONGO_APP_PASSWORD=change-me
# Use only URL-safe characters in the app password (hex is ideal).
MONGODB_URI=mongodb://apex_app:change-me@mongo:27017/apex?authSource=apex

# --- App ---
PUBLIC_SITE_URL=https://apexcaretechnologies.com
# openssl rand -hex 32  (min 32 chars; signs form tokens, keys IP hashes)
SESSION_SECRET=
# openssl rand -hex 24  (optional; enables POST /api/cron/notifications)
CRON_SECRET=
# true when behind a reverse proxy / CDN that sets X-Forwarded-For (strip client-sent values!)
TRUST_PROXY=true
# optional: comma-separated extra origins allowed to call the public API from a browser
ALLOWED_ORIGINS=
LOG_LEVEL=info
SESSION_TTL_DAYS=7
UPLOAD_MAX_MB=8

# --- Mail (optional: without SMTP_HOST, enquiries are stored but no email is sent) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Apex Care Technologies <no-reply@apexcaretechnologies.com>"
# Where new-enquiry emails go (comma-separated). Overrides the recipients set in site settings.
SALES_EMAIL=
AUTO_REPLY=true

# --- Outbound webhook for new enquiries (optional; payload is HMAC-signed with the secret) ---
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=

# --- First admin, created by `npm run seed` when no users exist ---
ADMIN_EMAIL=
ADMIN_NAME=Site Administrator
ADMIN_PASSWORD=

# --- Data retention (days) ---
ANALYTICS_RETENTION_DAYS=400
AUDIT_RETENTION_DAYS=730
SPAM_RETENTION_DAYS=30
